# --- Gemini (Google AI Studio free-tier key: https://aistudio.google.com/apikey) ---
# FREE TIER ONLY: never link a billing account to this key's project. A project
# without billing cannot be charged; over-limit requests just fail with 429 and
# the app waits or moves to the next model.
GEMINI_API_KEY=

# Model chains per step, tried left to right. Leave these unset to use the
# default for every step: gemini-2.5-flash -> gemini-3.5-flash-lite -> gemini-2.5-flash-lite.
# - A model whose daily free quota is used up is skipped until midnight Pacific.
# - A model that answers "busy" (503) or times out gets one quick retry, then is
#   set aside for 5 minutes and the next model answers instead; a per-minute
#   limit switches models at once. The sidebar shows which models are busy.
# Only free-tier models are accepted: gemini-2.5-flash (shuts down 2026-12-01,
# dropped automatically from then on), gemini-2.5-flash-lite, gemini-3.5-flash-lite.
# gemini-2.5-flash and -lite include free Google Search (500 requests/day), used
# for metadata and fact-checks; without it the result is marked "not grounded".
# Watches the video / looks at the image:
GEMINI_ANALYSIS_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Writes the recreation prompt:
GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Writes the YouTube / Instagram metadata:
GEMINI_METADATA_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# --- Dialogue and metadata language ---
# How dialogue is written in the video prompt: native (Telugu script, Devanagari, ...)
# or romanized (Latin letters) -- use whichever your video generator pronounces better.
DIALOGUE_SCRIPT=native
# Metadata for non-English videos: auto (English mixed with romanized Telugu/Hindi,
# the way viewers search), english, or native.
METADATA_LANGUAGE=auto

# Client-side throttle: max Gemini calls per minute. Keep it a little under
# your free-tier RPM (https://aistudio.google.com/rate-limit) so 429s are rare.
GEMINI_RPM=8
# How long to keep waiting/retrying through rate limits before giving up.
RATE_LIMIT_MAX_WAIT_SECONDS=900

# Summarise to Short: fact-checked script + image prompts.
GEMINI_STORY_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# --- Input video limits ---
MAX_VIDEO_SECONDS=60
# Summarise to Short accepts longer sources (YouTube / Instagram up to 5 min).
SUMMARY_MAX_VIDEO_SECONDS=300
MIN_VIDEO_SECONDS=1
MAX_DOWNLOAD_MB=200

# --- Output ---
# Lengths offered to the user (one is picked before generating the prompt).
OUTPUT_DURATIONS=8,10
# The free tier can only produce text, so the video-generation prompt and the
# reference-image prompts ARE the output.
# true  = show them on screen (copy buttons) -- default
# false = only save them to WORK_DIR/prompts and offer a download button
SHOW_PROMPT=true
# Downloads, analysis cache and saved prompts (relative to this folder).
WORK_DIR=work

# --- Download helpers (optional) ---
# Netscape-format cookies.txt exported from a logged-in browser. Needed for
# most Instagram posts and for YouTube's "confirm you're not a bot" wall.
COOKIES_FILE=
# e.g. http://user:pass@host:port
DOWNLOAD_PROXY=

# --- Link safety ---
# Links to private/internal addresses (localhost, 10.x, 169.254.169.254, ...) are
# always refused. Optionally accept links only from these sites (comma-separated,
# subdomains included). Recommended for a public deployment. Empty = any public site.
# e.g. URL_ALLOWLIST=youtube.com,youtu.be,instagram.com,tiktok.com,x.com,twitter.com,facebook.com,fb.watch
URL_ALLOWLIST=
